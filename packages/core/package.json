{
  "name": "@sheetgrid/core",
  "version": "0.3.0",
  "description": "SheetGrid engine — data model, virtualization, selection, validation, layout",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkdadson/sheetgrid.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pkdadson/sheetgrid/tree/main/packages/core#readme",
  "bugs": "https://github.com/pkdadson/sheetgrid/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./commands": {
      "types": "./dist/model/commands/index.d.ts",
      "import": "./dist/model/commands/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sheetgrid",
    "datagrid",
    "spreadsheet",
    "virtualization",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
