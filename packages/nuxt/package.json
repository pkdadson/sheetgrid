{
  "name": "@sheetgrid/nuxt",
  "version": "0.1.0-alpha.5",
  "description": "Nuxt 3 module for @sheetgrid/vue — auto-imports composables and registers <SheetGrid> globally.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sheetgrid",
    "nuxt",
    "nuxt3",
    "vue",
    "datagrid",
    "spreadsheet"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "nuxt": ">=3.10.0"
  },
  "dependencies": {
    "@sheetgrid/vue": "workspace:^",
    "@nuxt/kit": "^3.10.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^0.8.0",
    "@nuxt/schema": "^3.10.0",
    "nuxt": "^3.10.0",
    "typescript": "^5.6.0"
  }
}
