{
  "name": "@sheetgrid/agent",
  "version": "0.1.0-alpha.1",
  "description": "SheetGrid — framework-agnostic controller and LLM tool descriptors for agentic apps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "sheetgrid",
    "datagrid",
    "agent",
    "ai",
    "llm",
    "tool-calling",
    "controller"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@sheetgrid/core": ">=0.3.0"
  },
  "devDependencies": {
    "@sheetgrid/core": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
